# Database (PostgreSQL)
POSTGRES_HOST=
POSTGRES_PORT=
POSTGRES_DB=
POSTGRES_USER=
POSTGRES_PASSWORD=

# Redis
REDIS_HOST=
REDIS_PORT=

# S3
S3_ENDPOINT=
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_REGION=
S3_PRESIGNED_EXPIRATION=

# JWT
JWT_SECRET=
JWT_ACCESS_EXPIRATION=
JWT_REFRESH_EXPIRATION=

# Gmail
MAIL_USERNAME=
MAIL_PASSWORD=

# Expo Push Notifications
EXPO_ACCESS_TOKEN=

# Logging (선택)
# NODE_ENV=production 이면 JSON 로그, 아니면 개발용 pretty 로그
NODE_ENV=
# 로그 레벨: trace|debug|info|warn|error (미설정 시 dev=debug, prod=info)
LOG_LEVEL=
# 파일 로그 디렉터리 (지정 시 JSON 파일 로그 + 일/50MB 단위 교체, 14개 보관. docker-compose는 /app/logs)
LOG_DIR=

# CORS
CORS_ENABLED=true
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,https://batchar.vercel.app
